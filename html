function icon(check){
  return check
    ? '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#1f9d55" stroke-width="2.4"><path d="m5 13 4 4 10-11"/></svg>'
    : '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c0392b" stroke-width="2.4"><path d="M6 6l12 12M18 6 6 18"/></svg>';
}

