<script>
(function(){
"use strict";

/* ===================== Utilities ===================== */
function uid(){ return 'id_' + Date.now().toString(36) + Math.random().toString(36).slice(2,8); }
function fmtZAR(n){
  n = Number(n)||0;
  var neg = n < 0; n = Math.abs(n);
  var parts = n.toFixed(2).split('.');
  parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
  return (neg?'-':'') + 'R' + parts[0] + ',' + parts[1];
}
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
function todayISO(){ return new Date().toISOString().slice(0,10); }
function monthLabel(y,m){ return new Date(y, m-1, 1).toLocaleDateString('en-ZA',{month:'long',year:'numeric'}); }
function ageFromDOB(dob){
  if(!dob) return null;
  var d = new Date(dob), t = new Date();
  var age = t.getFullYear()-d.getFullYear();
  var m = t.getMonth()-d.getMonth();
  if(m<0 || (m===0 && t.getDate()<d.getDate())) age--;
  return age;
}
function daysBetween(a,b){
  return Math.round((new Date(b)-new Date(a))/86400000)+1;
}
function clientId(){ return 'anon_'+Math.random().toString(36).slice(2); }

/* ===================== Tax engine (2026/2027 SARS tax year) ===================== */
var TAX_BRACKETS = [
  {min:0,        max:245100,   base:0,      rate:0.18},
  {min:245100,   max:383100,   base:44118,  rate:0.26},
  {min:383100,   max:530200,   base:79998,  rate:0.31},
  {min:530200,   max:695800,   base:125599, rate:0.36},
  {min:695800,   max:887000,   base:185215, rate:0.39},
  {min:887000,   max:1878600,  base:259783, rate:0.41},
  {min:1878600,  max:Infinity, base:666339, rate:0.45}
];
var REBATE_PRIMARY = 17820, REBATE_SECONDARY = 9765, REBATE_TERTIARY = 3249;
var UIF_CEILING_MONTHLY = 17712, UIF_RATE = 0.01;
var SDL_RATE = 0.01, SDL_ANNUAL_THRESHOLD = 500000;

function annualTaxOn(taxableAnnual){
  taxableAnnual = Math.max(0, taxableAnnual);
  for(var i=0;i<TAX_BRACKETS.length;i++){
    var b = TAX_BRACKETS[i];
    if(taxableAnnual <= b.max){
      return b.base + b.rate*(taxableAnnual - b.min);
    }
  }
  return 0;
}
function medicalCreditMonthly(dependants){
  dependants = Number(dependants)||0;
  if(dependants<=0) return 0;
  if(dependants===1) return 376;
  return 752 + 254*(dependants-1);
}
function calcPayslipLine(emp, company){
  var basic = emp.payFrequency==='hourly'
    ? (Number(emp.hourlyRate)||0) * (Number(emp.standardHours)||160)
    : (Number(emp.basicSalary)||0);
  var travel = Number(emp.travelAllowance)||0;
  var other = Number(emp.otherAllowance)||0;
  var gross = basic + travel + other;
  var annualGross = gross*12;
  var retMonthly = Number(emp.retirementContribution)||0;
  var retAnnualRaw = retMonthly*12;
  var retAnnual = Math.min(retAnnualRaw, 0.275*annualGross);
  var taxableAnnual = Math.max(0, annualGross - retAnnual);
  var taxAnnual = annualTaxOn(taxableAnnual);
  var age = ageFromDOB(emp.dob);
  var rebate = REBATE_PRIMARY + (age!==null && age>=65?REBATE_SECONDARY:0) + (age!==null && age>=75?REBATE_TERTIARY:0);
  var medCreditAnnual = medicalCreditMonthly(emp.medicalDependants)*12;
  var taxPayableAnnual = Math.max(0, taxAnnual - rebate - medCreditAnnual);
  var paye = Math.round(taxPayableAnnual/12);
  var uifBase = Math.min(gross, UIF_CEILING_MONTHLY);
  var uifEmployee = Math.round(uifBase*UIF_RATE*100)/100;
  var uifEmployer = uifEmployee;
  var sdlEmployer = company && company.sdlApplicable ? Math.round(gross*SDL_RATE*100)/100 : 0;
  var medicalAidDed = Number(emp.medicalAidContribution)||0;
  var otherDed = Number(emp.otherDeduction)||0;
  var totalDeductions = paye + uifEmployee + retMonthly + medicalAidDed + otherDed;
  var netPay = gross - totalDeductions;
  var employerCost = gross + uifEmployer + sdlEmployer;
  return {
    employeeId: emp.id, employeeName: (emp.firstName+' '+emp.lastName).trim(),
    basic: basic, travelAllowance: travel, otherAllowance: other, gross: gross,
    retirementDeduction: retMonthly, medicalAidDeduction: medicalAidDed, otherDeduction: otherDed,
    paye: paye, uifEmployee: uifEmployee, uifEmployer: uifEmployer, sdlEmployer: sdlEmployer,
    medicalCreditMonthly: medicalCreditMonthly(emp.medicalDependants),
    totalDeductions: totalDeductions, netPay: netPay, employerCost: employerCost
  };
}

/* ===================== DB layer ===================== */
var db = null;
var dbReady = false;
var state = {
  companies: [],
  employees: [],
  payruns: [],
  leave: [],
  currentCompanyId: null,
  route: 'dashboard',
  routeParam: null
};

function saveLastCompany(id){
  try{ localStorage.setItem('reconi_last_company', id); }catch(e){}
}
function loadLastCompany(){
  try{ return localStorage.getItem('reconi_last_company'); }catch(e){ return null; }
}

function setSync(text, ok){
  var dot = document.getElementById('syncDot');
  var t = document.getElementById('syncText');
  if(t) t.textContent = text;
  if(dot) dot.style.background = ok===false ? '#e0a13c' : '#3ec97a';
}

function defaultCompany(name){
  return {
    id: uid(), name: name||'New Client Company (Pty) Ltd', regNo:'', payeRef:'', uifRef:'', sdlRef:'',
    sdlApplicable:false, payDay:25, address:'',
    defaultAnnualLeaveDays:15, defaultSickLeaveDays:10, defaultFamilyRespDays:3,
    createdAt: Date.now()
  };
}

async function initDb(){
  try{
    db = await claude.use('db');
  }catch(e){ db = null; }
  if(!db){
    setSync('Offline — changes stay in this browser only', false);
    loadLocalFallback();
    finishBoot();
    return;
  }
  try{
    var companiesRes = await db.collection('companies').get();
    var companies = (companiesRes && companiesRes.docs) || [];
    if(!companies.length){
      var seed = defaultCompany('Test Client (Pty) Ltd');
      await db.doc('companies/'+seed.id).set(seed);
      companies = [seed];
    }
    state.companies = companies;
    var last = loadLastCompany();
    state.currentCompanyId = (last && companies.some(function(c){return c.id===last;})) ? last : companies[0].id;

    var empRes = await db.collection('employees').get();
    state.employees = (empRes && empRes.docs) || [];
    var prRes = await db.collection('payruns').get();
    state.payruns = (prRes && prRes.docs) || [];
    var lvRes = await db.collection('leave_requests').get();
    state.leave = (lvRes && lvRes.docs) || [];

    setSync('Saved just now', true);
    dbReady = true;
  }catch(e){
    console.log('db init error', e);
    setSync('Offline — changes stay in this browser only', false);
    loadLocalFallback();
  }
  finishBoot();
}

function loadLocalFallback(){
  try{
    var raw = localStorage.getItem('reconi_fallback_data');
    if(raw){
      var data = JSON.parse(raw);
      state.companies = data.companies||[];
      state.employees = data.employees||[];
      state.payruns = data.payruns||[];
      state.leave = data.leave||[];
    }
  }catch(e){}
  if(!state.companies.length){
    state.companies = [defaultCompany('Test Client (Pty) Ltd')];
  }
  var last = loadLastCompany();
  state.currentCompanyId = (last && state.companies.some(function(c){return c.id===last;})) ? last : state.companies[0].id;
}
function persistLocalFallback(){
  try{
    localStorage.setItem('reconi_fallback_data', JSON.stringify({
      companies: state.companies, employees: state.employees, payruns: state.payruns, leave: state.leave
    }));
  }catch(e){}
}

/* Generic write helpers that work whether db is live or we fall back to localStorage */
async function dbSet(collection, doc){
  if(db){
    try{
      setSync('Saving…');
      await db.doc(collection+'/'+doc.id).set(doc);
      setSync('Saved just now', true);
      return true;
    }catch(e){ console.log('save error', e); setSync('Save failed — retry', false); return false; }
  }else{
    persistLocalFallback();
    return true;
  }
}
async function dbDelete(collection, id){
  if(db){
    try{
      await db.doc(collection+'/'+id).delete();
      return true;
    }catch(e){ console.log('delete error', e); return false; }
  }else{
    persistLocalFallback();
    return true;
  }
}

function upsertLocal(arr, doc){
  var idx = arr.findIndex(function(x){return x.id===doc.id;});
  if(idx>=0) arr[idx] = doc; else arr.push(doc);
}
function removeLocal(arr, id){
  var idx = arr.findIndex(function(x){return x.id===id;});
  if(idx>=0) arr.splice(idx,1);
}

async function saveCompany(doc){ upsertLocal(state.companies, doc); await dbSet('companies', doc); }
async function saveEmployee(doc){ upsertLocal(state.employees, doc); await dbSet('employees', doc); }
async function savePayrun(doc){ upsertLocal(state.payruns, doc); await dbSet('payruns', doc); }
async function saveLeave(doc){ upsertLocal(state.leave, doc); await dbSet('leave_requests', doc); }
async function deleteLeave(id){ removeLocal(state.leave, id); await dbDelete('leave_requests', id); }

/* ===================== Scoped getters ===================== */
function currentCompany(){
  return state.companies.find(function(c){return c.id===state.currentCompanyId;}) || state.companies[0];
}
function companyEmployees(status){
  return state.employees.filter(function(e){
    return e.companyId===state.currentCompanyId && (status?e.status===status:true);
  });
}
function companyPayruns(){
  return state.payruns.filter(function(p){return p.companyId===state.currentCompanyId;})
    .sort(function(a,b){ return (b.periodYear-a.periodYear) || (b.periodMonth-a.periodMonth); });
}
function companyLeave(){
  return state.leave.filter(function(l){return l.companyId===state.currentCompanyId;});
}
function employeeById(id){ return state.employees.find(function(e){return e.id===id;}); }

function leaveTakenFor(employeeId, type){
  return companyLeave().filter(function(l){return l.employeeId===employeeId && l.type===type;})
    .reduce(function(sum,l){ return sum+(Number(l.days)||0); }, 0);
}

/* ===================== Router / Render ===================== */
function navigate(route, param){
  state.route = route; state.routeParam = param||null;
  document.querySelectorAll('.nav-item').forEach(function(el){
    el.classList.toggle('active', el.dataset.route===route);
  });
  closeSidebarMobile();
