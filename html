      +'<div class="form-field span2"><label>Address</label><textarea id="companyAddress" rows="2">'+esc(c.address)+'</textarea></div>'
      +field('Default annual leave days/year','companyAnnLeave',c.defaultAnnualLeaveDays)
      +field('Default sick leave days/year','companySickLeave',c.defaultSickLeaveDays)
      +field('Default family resp. days/year','companyFamLeave',c.defaultFamilyRespDays)
    +'</div>'
    +'<div class="modal-actions"><button class="btn btn-primary" id="saveCompanyBtn">Save company details</button></div>'
  +'</div>';
}
function field(label,id,val,type){
  return '<div class="form-field"><label>'+label+'</label><input type="'+(type||'text')+'" id="'+id+'" value="'+esc(val==null?'':val)+'"></div>';
}

/* ---------- Reports ---------- */
function renderReports(){
  var runs = companyPayruns().filter(function(r){return r.status==='finalized';});
  var totalGross=0,totalPaye=0,totalUifE=0,totalUifR=0,totalSdl=0,totalNet=0,totalCost=0;
  runs.forEach(function(r){
    totalGross+=r.totals.gross; totalPaye+=r.totals.paye; totalUifE+=r.totals.uifEmployee;
    totalUifR+=r.totals.uifEmployer; totalSdl+=r.totals.sdlEmployer; totalNet+=r.totals.netPay; totalCost+=r.totals.employerCost;
  });
  var rows = runs.map(function(r){
    return '<tr><td>'+esc(r.periodLabel)+'</td><td>'+fmtZAR(r.totals.gross)+'</td><td>'+fmtZAR(r.totals.paye)+'</td>'
    +'<td>'+fmtZAR(r.totals.uifEmployee+r.totals.uifEmployer)+'</td><td>'+fmtZAR(r.totals.sdlEmployer)+'</td><td>'+fmtZAR(r.totals.netPay)+'</td></tr>';
  }).join('');
  return ''
  +'<div class="topbar"><div><h1>Reports</h1><div class="subtitle">PAYE / UIF / SDL liability summary — finalized pay runs, this tax year</div></div>'
    +'<div class="topbar-right"><button class="btn" id="exportCsvBtn">Export CSV</button></div></div>'
  +'<div class="stat-grid">'
    +statCard('TOTAL PAYE LIABILITY', fmtZAR(totalPaye), 'Owed to SARS')
    +statCard('TOTAL UIF (BOTH SIDES)', fmtZAR(totalUifE+totalUifR), 'Owed to UIF')
    +statCard('TOTAL SDL', fmtZAR(totalSdl), 'Owed to SETA/SARS')
    +statCard('TOTAL PAYROLL COST', fmtZAR(totalCost), 'Gross + employer contributions')
  +'</div>'
  +'<div class="card"><div class="table-wrap"><table><thead><tr><th>Period</th><th>Gross</th><th>PAYE</th><th>UIF</th><th>SDL</th><th>Net pay</th></tr></thead><tbody>'
  +(rows||'<tr><td colspan="6" class="empty-row">No finalized pay runs yet.</td></tr>')
  +'</tbody></table></div></div>';
}

/* ===================== Event wiring ===================== */
function wireRouteEvents(){
  document.querySelectorAll('[data-route-link]').forEach(function(el){
    el.onclick = function(){ navigate(el.dataset.routeLink); };
  });
  document.querySelectorAll('[data-open-run]').forEach(function(el){
    el.onclick = function(){ state.route='payrun-detail'; state.routeParam={runId:el.dataset.openRun}; renderCustom(); };
  });
  document.querySelectorAll('[data-view-payslip]').forEach(function(el){
    el.onclick = function(){
      var parts = el.dataset.viewPayslip.split('|');
      document.getElementById('page-root').innerHTML = renderPayslipView(parts[0], parts[1]);
      wireRouteEvents();
    };
  });
  var payslipSel = document.getElementById('payslipRunSelect');
  if(payslipSel){
    payslipSel.onchange = function(){
      state.routeParam = {runId: payslipSel.value};
      document.getElementById('page-root').innerHTML = renderPayslips();
      wireRouteEvents();
    };
  }

  var addEmpBtn = document.getElementById('addEmpBtn');
  if(addEmpBtn) addEmpBtn.onclick = function(){ openEmployeeModal(null); };
  document.querySelectorAll('[data-edit-emp]').forEach(function(el){
    el.onclick = function(){ openEmployeeModal(el.dataset.editEmp); };
  });
  document.querySelectorAll('[data-terminate-emp]').forEach(function(el){
    el.onclick = function(){ openTerminateModal(el.dataset.terminateEmp); };
  });
  document.querySelectorAll('[data-reinstate-emp]').forEach(function(el){
    el.onclick = async function(){
      var e = employeeById(el.dataset.reinstateEmp);
      e.status='active'; e.terminationDate=''; e.terminationReason='';
      await saveEmployee(e); navigate('employees');
    };
  });

  var newRunBtn = document.getElementById('newRunBtn');
  if(newRunBtn) newRunBtn.onclick = openNewRunModal;
  var finalizeBtn = document.getElementById('finalizeRunBtn');
  if(finalizeBtn) finalizeBtn.onclick = function(){ finalizeRun(finalizeBtn.dataset.run); };

  document.querySelectorAll('[data-capture-leave]').forEach(function(el){
    el.onclick = function(){ openLeaveModal(el.dataset.captureLeave); };
  });
  document.querySelectorAll('[data-delete-leave]').forEach(function(el){
    el.onclick = async function(){ await deleteLeave(el.dataset.deleteLeave); navigate('leave'); };
  });

  var saveCompanyBtn = document.getElementById('saveCompanyBtn');
  if(saveCompanyBtn) saveCompanyBtn.onclick = async function(){
    var c = currentCompany();
    c.name = document.getElementById('companyName').value.trim() || c.name;
    c.regNo = document.getElementById('companyReg').value.trim();
    c.payeRef = document.getElementById('companyPaye').value.trim();
    c.uifRef = document.getElementById('companyUif').value.trim();
    c.sdlRef = document.getElementById('companySdl').value.trim();
    c.sdlApplicable = document.getElementById('companySdlApplicable').value === 'true';
    c.payDay = Number(document.getElementById('companyPayDay').value)||25;
    c.address = document.getElementById('companyAddress').value;
    c.defaultAnnualLeaveDays = Number(document.getElementById('companyAnnLeave').value)||15;
    c.defaultSickLeaveDays = Number(document.getElementById('companySickLeave').value)||10;
    c.defaultFamilyRespDays = Number(document.getElementById('companyFamLeave').value)||3;
    await saveCompany(c);
    render();
  };

  var exportBtn = document.getElementById('exportCsvBtn');
  if(exportBtn) exportBtn.onclick = exportReportsCsv;
}
function renderCustom(){
  if(state.route==='payrun-detail'){
    document.getElementById('page-root').innerHTML = renderPayrunDetail(state.routeParam.runId);
    renderCompanySwitcher();
    wireRouteEvents();
  }
}

/* ---------- Modals ---------- */
function openModal(html){
  var root = document.getElementById('modal-root');
  root.innerHTML = '<div class="modal-overlay" id="modalOverlay"><div class="modal">'+html+'</div></div>';
  document.getElementById('modalOverlay').addEventListener('click', function(e){
    if(e.target.id==='modalOverlay') closeModal();
  });
}
function closeModal(){ document.getElementById('modal-root').innerHTML=''; }

function openEmployeeModal(id){
  var e = id ? employeeById(id) : {
    id: uid(), companyId: state.currentCompanyId, status:'active', payFrequency:'monthly',
    firstName:'', lastName:'', position:'', startDate: todayISO()
  };
  var isHourly = e.payFrequency==='hourly';
  openModal(''
    +'<h2>'+(id?'Edit employee':'Add employee')+'</h2>'
    +'<div class="section-title">Personal details</div>'
    +'<div class="form-grid">'
      +field('First name','fFirst',e.firstName)+field('Last name','fLast',e.lastName)
      +field('ID number','fId',e.idNumber)+field('Date of birth','fDob',e.dob,'date')
      +field('Tax number','fTax',e.taxNumber)+field('UIF number','fUif',e.uifNumber)
      +field('Position','fPosition',e.position)+field('Employee number','fEmpNo',e.employeeNo)
      +field('Start date','fStart',e.startDate,'date')
    +'</div>'
    +'<div class="section-title">Pay</div>'
    +'<div class="form-grid">'
      +'<div class="form-field"><label>Pay frequency</label><select id="fPayFreq">'
        +'<option value="monthly"'+(isHourly?'':' selected')+'>Monthly salary</option>'
        +'<option value="hourly"'+(isHourly?' selected':'')+'>Hourly rate</option></select></div>'
      +field('Basic monthly salary (if monthly)','fBasic',e.basicSalary,'number')
      +field('Hourly rate (if hourly)','fHourly',e.hourlyRate,'number')
      +field('Standard hours/month (if hourly)','fStdHours',e.standardHours||160,'number')
      +field('Travel allowance (monthly)','fTravel',e.travelAllowance,'number')
      +field('Other allowance (monthly)','fOther',e.otherAllowance,'number')
    +'</div>'
    +'<div class="section-title">Deductions &amp; benefits</div>'
    +'<div class="form-grid">'
      +field('Retirement fund contribution (employee, monthly R)','fRet',e.retirementContribution,'number')
      +field('Medical aid contribution (employee, monthly R)','fMed',e.medicalAidContribution,'number')
      +field('Medical aid dependants (incl. main member, 0 = none)','fMedDep',e.medicalDependants||0,'number')
      +field('Other monthly deduction (R)','fOtherDed',e.otherDeduction,'number')
    +'</div>'
    +'<div class="section-title">Banking</div>'
    +'<div class="form-grid">'
      +field('Bank name','fBank',e.bankName)+field('Account number','fAcc',e.accountNumber)
      +field('Branch code','fBranch',e.branchCode)
      +'<div class="form-field"><label>Account type</label><select id="fAccType">'
        +['Cheque/Current','Savings'].map(function(t){return '<option'+(e.accountType===t?' selected':'')+'>'+t+'</option>';}).join('')
      +'</select></div>'
    +'</div>'
    +'<div class="section-title">Leave entitlement (days/year, blank = company default)</div>'
    +'<div class="form-grid">'
      +field('Annual leave days/year','fAnnLeave',e.annualLeaveDaysPerYear)
      +field('Sick leave days/year','fSickLeave',e.sickLeaveDaysPerYear)
      +field('Family responsibility days/year','fFamLeave',e.familyRespDaysPerYear)
    +'</div>'
    +'<div class="modal-actions"><button class="btn" id="cancelEmpBtn">Cancel</button><button class="btn btn-primary" id="saveEmpBtn">Save employee</button></div>'
  );
  document.getElementById('cancelEmpBtn').onclick = closeModal;
  document.getElementById('saveEmpBtn').onclick = async function(){
    e.firstName = val('fFirst'); e.lastName = val('fLast'); e.idNumber = val('fId'); e.dob = val('fDob');
    e.taxNumber = val('fTax'); e.uifNumber = val('fUif'); e.position = val('fPosition'); e.employeeNo = val('fEmpNo');
    e.startDate = val('fStart'); e.payFrequency = val('fPayFreq');
    e.basicSalary = numVal('fBasic'); e.hourlyRate = numVal('fHourly'); e.standardHours = numVal('fStdHours');
    e.travelAllowance = numVal('fTravel'); e.otherAllowance = numVal('fOther');
    e.retirementContribution = numVal('fRet'); e.medicalAidContribution = numVal('fMed');
    e.medicalDependants = numVal('fMedDep'); e.otherDeduction = numVal('fOtherDed');
    e.bankName = val('fBank'); e.accountNumber = val('fAcc'); e.branchCode = val('fBranch'); e.accountType = val('fAccType');
    e.annualLeaveDaysPerYear = val('fAnnLeave')===''?null:numVal('fAnnLeave');
    e.sickLeaveDaysPerYear = val('fSickLeave')===''?null:numVal('fSickLeave');
    e.familyRespDaysPerYear = val('fFamLeave')===''?null:numVal('fFamLeave');
    if(!e.firstName){ alert('First name is required.'); return; }
    await saveEmployee(e);
    closeModal();
    navigate('employees');
  };
}
function val(id){ var el=document.getElementById(id); return el?el.value.trim():''; }
function numVal(id){ var el=document.getElementById(id); return el && el.value!=='' ? Number(el.value) : 0; }

function openTerminateModal(id){
  var e = employeeById(id);
  openModal(''
    +'<h2>Terminate '+esc(e.firstName+' '+e.lastName)+'</h2>'
    +'<div class="form-grid">'
      +field('Termination date','tDate',todayISO(),'date')
      +field('Reason','tReason','')
    +'</div>'
    +'<div class="modal-actions"><button class="btn" id="cancelTermBtn">Cancel</button><button class="btn btn-danger" id="confirmTermBtn">Confirm termination</button></div>'
  );
  document.getElementById('cancelTermBtn').onclick = closeModal;
  document.getElementById('confirmTermBtn').onclick = async function(){
    e.status='terminated'; e.terminationDate=val('tDate'); e.terminationReason=val('tReason');
    await saveEmployee(e);
    closeModal();
    navigate('employees');
  };
}

function openLeaveModal(employeeId){
  var e = employeeById(employeeId);
  openModal(''
    +'<h2>Capture leave — '+esc(e.firstName+' '+e.lastName)+'</h2>'
    +'<div class="form-grid">'
      +'<div class="form-field"><label>Leave type</label><select id="lType"><option value="annual">Annual</option><option value="sick">Sick</option><option value="family">Family responsibility</option></select></div>'
      +field('Start date','lStart',todayISO(),'date')
      +field('End date','lEnd',todayISO(),'date')
      +field('Note (optional)','lNote','')
    +'</div>'
    +'<div class="modal-actions"><button class="btn" id="cancelLeaveBtn">Cancel</button><button class="btn btn-primary" id="saveLeaveBtn">Save leave</button></div>'
  );
  document.getElementById('cancelLeaveBtn').onclick = closeModal;
  document.getElementById('saveLeaveBtn').onclick = async function(){
    var start=val('lStart'), end=val('lEnd');
    var days = Math.max(1, daysBetween(start,end));
    var doc = { id: uid(), companyId: state.currentCompanyId, employeeId: employeeId,
      type: val('lType'), startDate:start, endDate:end, days:days, note: val('lNote') };
    await saveLeave(doc);
    closeModal();
    navigate('leave');
  };
}

function openNewRunModal(){
  var now = new Date();
  openModal(''
    +'<h2>New pay run</h2>'
    +'<div class="form-grid">'
      +'<div class="form-field"><label>Month</label><select id="rMonth">'
        +Array.from({length:12},function(_,i){return i+1;}).map(function(m){
          return '<option value="'+m+'"'+(m===now.getMonth()+1?' selected':'')+'>'+new Date(2000,m-1,1).toLocaleDateString('en-ZA',{month:'long'})+'</option>';
        }).join('')+'</select></div>'
      +field('Year','rYear',now.getFullYear(),'number')
      +field('Pay date','rPayDate',todayISO(),'date')
    +'</div>'
    +'<div class="helptext">A draft pay run will be created for all active employees. Review and finalize it from the Pay Runs screen.</div>'
    +'<div class="modal-actions"><button class="btn" id="cancelRunBtn">Cancel</button><button class="btn btn-primary" id="createRunBtn">Create draft</button></div>'
  );
  document.getElementById('cancelRunBtn').onclick = closeModal;
  document.getElementById('createRunBtn').onclick = async function(){
    var month = Number(val('rMonth')), year = numVal('rYear'), payDate = val('rPayDate');
    var company = currentCompany();
    var active = companyEmployees('active');
    if(!active.length){ alert('Add at least one active employee before creating a pay run.'); return; }
    var lines = active.map(function(emp){ return calcPayslipLine(emp, company); });
    var totals = lines.reduce(function(t,l){
      t.gross+=l.gross; t.paye+=l.paye; t.uifEmployee+=l.uifEmployee; t.uifEmployer+=l.uifEmployer;
      t.sdlEmployer+=l.sdlEmployer; t.netPay+=l.netPay; t.employerCost+=l.employerCost; return t;
    }, {gross:0,paye:0,uifEmployee:0,uifEmployer:0,sdlEmployer:0,netPay:0,employerCost:0});
    var run = {
      id: uid(), companyId: state.currentCompanyId, periodMonth: month, periodYear: year,
      periodLabel: monthLabel(year, month), payDate: payDate, status:'draft', lines: lines, totals: totals,
      createdAt: Date.now()
    };
    await savePayrun(run);
    closeModal();
    state.route='payrun-detail'; state.routeParam={runId:run.id};
    renderCustom();
  };
}
async function finalizeRun(runId){
  var r = state.payruns.find(function(x){return x.id===runId;});
  if(!r) return;
  if(!confirm('Finalize this pay run? Payslips will be generated and figures will be locked.')) return;
  r.status='finalized'; r.finalizedAt = Date.now();
  await savePayrun(r);
  renderCustom();
}

function exportReportsCsv(){
  var runs = companyPayruns().filter(function(r){return r.status==='finalized';});
  var lines = ['Period,Pay Date,Gross,PAYE,UIF Employee,UIF Employer,SDL,Net Pay,Employer Cost'];
  runs.forEach(function(r){
    lines.push([r.periodLabel, r.payDate, r.totals.gross, r.totals.paye, r.totals.uifEmployee, r.totals.uifEmployer, r.totals.sdlEmployer, r.totals.netPay, r.totals.employerCost].join(','));
  });
  var csv = lines.join('\n');
  claude.use('downloads').then(function(downloads){
    if(downloads){
      downloads.save({filename:'reconi-payroll-report.csv', data: csv}).catch(function(){ fallbackCsv(csv); });
    } else { fallbackCsv(csv); }
  }).catch(function(){ fallbackCsv(csv); });
}
function fallbackCsv(csv){
  alert('Download isn\'t available in this view — here is the CSV data:\n\n'+csv.slice(0,2000));
}

/* ---------- Sidebar / company menu wiring ---------- */
function wireStaticEvents(){
  document.querySelectorAll('.nav-item').forEach(function(el){
    el.addEventListener('click', function(){ navigate(el.dataset.route); });
  });
  var pill = document.getElementById('companyPill');
  var menu = document.getElementById('companyMenu');
  pill.addEventListener('click', function(e){ e.stopPropagation(); menu.classList.toggle('open'); });
  document.addEventListener('click', function(){ menu.classList.remove('open'); });
  menu.addEventListener('click', function(e){ e.stopPropagation(); });

  document.getElementById('menuToggle').addEventListener('click', function(){
    document.getElementById('sidebar').classList.add('open');
    document.getElementById('scrim').classList.add('open');
  });
  document.getElementById('scrim').addEventListener('click', closeSidebarMobile);
}
function closeSidebarMobile(){
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('scrim').classList.remove('open');
}
document.addEventListener('click', function(e){
  var menu = document.getElementById('companyMenu');
  if(!menu) return;
  var item = e.target.closest('.company-menu-item');
  if(item){
    state.currentCompanyId = item.dataset.cid;
    saveLastCompany(state.currentCompanyId);
    menu.classList.remove('open');
    navigate(state.route);
  }
  var addBtn = e.target.closest('#addCompanyBtn');
  if(addBtn){
    var name = prompt('New client company name:');
    if(name && name.trim()){
      var nc = defaultCompany(name.trim());
      saveCompany(nc).then(function(){
        state.currentCompanyId = nc.id;
        saveLastCompany(nc.id);
        navigate('company');
      });
    }
  }
});

