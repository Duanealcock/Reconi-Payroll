<title>Reconi Payroll</title>
<style>
:root{
  --navy-950:#0f1626;
  --navy-900:#151d30;
  --navy-850:#1a2338;
  --navy-800:#212b45;
  --navy-border:#2a3450;
  --gold:#caa042;
  --gold-light:#e0bb63;
  --bg:#eef1f5;
  --card:#ffffff;
  --text:#1e2433;
  --text-soft:#5b6472;
  --text-faint:#8891a0;
  --green:#1f9d55;
  --green-bg:#e8f7ee;
  --red:#c0392b;
  --border:#e5e8ee;
  --sidebar-w:230px;
  color-scheme: light;
}
*{box-sizing:border-box;}
body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  font-size:14px;
  -webkit-font-smoothing:antialiased;
}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;}

.app{display:flex;min-height:100vh;}

/* ---------- Sidebar ---------- */
.sidebar{
  width:var(--sidebar-w);
  flex-shrink:0;
  background:var(--navy-950);
  color:#c7cddb;
  display:flex;
  flex-direction:column;
  padding:18px 14px 14px;
  position:fixed;
  top:0;left:0;bottom:0;
  overflow-y:auto;
  z-index:40;
  transition:transform .2s ease;
}
.brand{display:flex;align-items:center;gap:10px;padding:2px 6px 14px;}
.brand svg{flex-shrink:0;}
.brand-text .name{font-weight:700;color:#fff;font-size:16px;letter-spacing:.5px;line-height:1.1;}
.brand-text .sub{font-size:9.5px;color:var(--gold-light);letter-spacing:1.5px;font-weight:600;}

.company-switch{position:relative;margin-bottom:16px;}
.company-pill{
  width:100%;
  display:flex;align-items:center;justify-content:space-between;gap:8px;
  background:var(--navy-850);
  border:1px solid var(--navy-border);
  color:#fff;
  padding:9px 10px;
  border-radius:8px;
  cursor:pointer;
  font-size:12.5px;
  font-weight:600;
}
.company-pill span.name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.company-pill .badge{
  background:var(--gold);
  color:#241a05;
  font-size:10.5px;
  font-weight:700;
  padding:1px 6px;
  border-radius:20px;
  flex-shrink:0;
}
.company-menu{
  display:none;
  position:absolute;top:100%;left:0;right:0;margin-top:6px;
  background:var(--navy-850);border:1px solid var(--navy-border);
  border-radius:8px;padding:6px;z-index:50;
  max-height:260px;overflow-y:auto;
  box-shadow:0 12px 28px rgba(0,0,0,.4);
}
.company-menu.open{display:block;}
.company-menu-item{
  padding:8px 9px;border-radius:6px;cursor:pointer;font-size:12.5px;
  display:flex;justify-content:space-between;gap:8px;color:#dfe3ec;
}
.company-menu-item:hover{background:var(--navy-800);}
.company-menu-item.active{color:var(--gold-light);font-weight:600;}
.company-menu-add{
  margin-top:4px;padding:8px 9px;border-radius:6px;font-size:12.5px;
  color:var(--gold-light);cursor:pointer;font-weight:600;border-top:1px solid var(--navy-border);
}
.company-menu-add:hover{background:var(--navy-800);}

.nav-group{margin-bottom:14px;}
.nav-label{
  font-size:10px;letter-spacing:1.3px;color:var(--text-faint);
  font-weight:700;padding:0 10px 6px;
}
.nav-item{
  display:flex;align-items:center;gap:10px;
  padding:8px 10px;border-radius:7px;margin-bottom:2px;
  font-size:13px;font-weight:500;color:#c7cddb;cursor:pointer;
  border-left:3px solid transparent;
}
.nav-item svg{flex-shrink:0;opacity:.85;}
.nav-item:hover{background:var(--navy-850);color:#fff;}
.nav-item.active{background:var(--navy-800);color:#fff;border-left-color:var(--gold);}
.nav-item.active svg{opacity:1;color:var(--gold-light);}

.sidebar-footer{
  margin-top:auto;padding-top:12px;border-top:1px solid var(--navy-border);
  font-size:11px;color:var(--text-faint);
}
.sidebar-footer .sync{display:flex;align-items:center;gap:6px;margin-bottom:8px;}
.sidebar-footer .dot{width:6px;height:6px;border-radius:50%;background:#3ec97a;display:inline-block;}
.sidebar-footer .email{color:#9aa2b2;word-break:break-all;}
.sidebar-footer .role{color:#77839a;}
.sidebar-footer .signout{color:var(--gold-light);font-weight:600;cursor:pointer;}

.menu-toggle{display:none;}

/* ---------- Main content ---------- */
.content{
  margin-left:var(--sidebar-w);
  flex:1;
  min-width:0;
  padding:22px 26px 60px;
}
.topbar{
  display:flex;justify-content:space-between;align-items:flex-start;
  margin-bottom:18px;flex-wrap:wrap;gap:10px;
}
.topbar h1{font-size:20px;margin:0 0 2px;color:var(--text);}
.topbar .subtitle{font-size:12.5px;color:var(--text-soft);}
.topbar-right{display:flex;gap:10px;align-items:center;flex-wrap:wrap;}

select, input, textarea{
  font-family:inherit;font-size:13px;padding:7px 10px;border-radius:7px;
  border:1px solid var(--border);background:#fff;color:var(--text);
}
select:focus, input:focus, textarea:focus{outline:2px solid #d9c690;}

.btn{
  border:1px solid var(--border);background:#fff;color:var(--text);
  padding:8px 14px;border-radius:7px;font-size:13px;font-weight:600;cursor:pointer;
}
.btn:hover{background:#f6f7f9;}
.btn-primary{background:var(--navy-950);color:#fff;border-color:var(--navy-950);}
.btn-primary:hover{background:var(--navy-850);}
.btn-gold{background:var(--gold);color:#241a05;border-color:var(--gold);}
.btn-gold:hover{background:var(--gold-light);}
.btn-danger{color:var(--red);border-color:#f0c6c0;}
.btn-danger:hover{background:#fdf1ef;}
.btn-sm{padding:5px 10px;font-size:12px;}
.btn[disabled]{opacity:.5;cursor:not-allowed;}

.label-caps{font-size:10.5px;letter-spacing:1px;color:var(--text-faint);font-weight:700;}

/* stat cards */
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:16px;}
.card{background:var(--card);border:1px solid var(--border);border-radius:11px;padding:16px;box-shadow:0 1px 2px rgba(20,25,40,.03);}
.stat-value{font-size:22px;font-weight:700;margin:6px 0 2px;color:var(--text);}
.stat-caption{font-size:11.5px;color:var(--text-soft);}

.two-col{display:grid;grid-template-columns:1.5fr 1fr;gap:14px;}
.card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;}
.card-title{font-weight:700;font-size:13.5px;}

table{width:100%;border-collapse:collapse;font-size:13px;}
th{
  text-align:left;font-size:10.5px;letter-spacing:.6px;color:var(--text-faint);
  font-weight:700;padding:8px 10px;border-bottom:1px solid var(--border);
}
td{padding:10px;border-bottom:1px solid var(--border);color:var(--text);}
tr:last-child td{border-bottom:none;}
.table-wrap{overflow-x:auto;}
.empty-row{color:var(--text-faint);text-align:center;padding:24px;font-size:13px;}

.pill-status{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:20px;font-size:11.5px;font-weight:700;}
.pill-green{background:var(--green-bg);color:var(--green);}
.pill-gray{background:#eef0f4;color:var(--text-soft);}
.pill-gold{background:#faf1de;color:#9c7524;}

.integrity-box{background:var(--green-bg);color:var(--green);border-radius:8px;padding:8px 12px;font-weight:700;font-size:12.5px;display:inline-flex;align-items:center;gap:6px;margin-bottom:12px;}
.integrity-warn{background:#fdf3e3;color:#9c6a15;}
.check-list{font-size:12.5px;color:var(--text-soft);line-height:1.9;}
.check-list b{color:var(--text);}

.page-actions{display:flex;gap:8px;flex-wrap:wrap;}

/* modal */
.modal-overlay{
  position:fixed;inset:0;background:rgba(15,20,35,.45);z-index:100;
  display:flex;align-items:flex-start;justify-content:center;padding:40px 16px;overflow-y:auto;
}
.modal{
  background:#fff;border-radius:12px;max-width:640px;width:100%;padding:22px 24px;
  box-shadow:0 20px 50px rgba(0,0,0,.25);
}
.modal h2{margin:0 0 14px;font-size:17px;}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.form-field{display:flex;flex-direction:column;gap:4px;margin-bottom:2px;}
.form-field label{font-size:11.5px;font-weight:700;color:var(--text-soft);}
.form-field.span2{grid-column:span 2;}
.modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px;}

.section-title{font-size:15px;font-weight:700;margin:22px 0 10px;}
.section-title:first-child{margin-top:0;}

.helptext{font-size:11.5px;color:var(--text-faint);margin-top:-6px;margin-bottom:10px;}

.payslip{border:1px solid var(--border);border-radius:10px;padding:22px;background:#fff;}
.payslip-head{display:flex;justify-content:space-between;border-bottom:2px solid var(--navy-950);padding-bottom:14px;margin-bottom:14px;}
.payslip-head h2{margin:0;font-size:18px;}
.payslip-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:16px;font-size:12.5px;}
.payslip-grid div div{margin-bottom:3px;}
.payslip-table th{background:#f7f8fa;}
.net-row td{font-weight:700;font-size:14px;border-top:2px solid var(--navy-950);}

.link-btn{color:#2454a8;font-weight:600;cursor:pointer;font-size:12.5px;}
.link-btn:hover{text-decoration:underline;}

.disclaimer{font-size:11px;color:var(--text-faint);margin-top:18px;border-top:1px dashed var(--border);padding-top:10px;line-height:1.6;}

@media (max-width:880px){
  .sidebar{transform:translateX(-100%);width:250px;}
  .sidebar.open{transform:translateX(0);}
  .content{margin-left:0;padding:16px;}
  .menu-toggle{
    display:flex;align-items:center;gap:8px;background:var(--navy-950);color:#fff;
    padding:10px 12px;border-radius:8px;border:none;font-weight:700;font-size:13px;
    margin-bottom:14px;cursor:pointer;
  }
  .stat-grid{grid-template-columns:1fr 1fr;}
  .two-col{grid-template-columns:1fr;}
  .form-grid{grid-template-columns:1fr;}
  .form-field.span2{grid-column:span 1;}
  .sidebar-scrim{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:35;}
  .sidebar-scrim.open{display:block;}
}
@media (max-width:520px){
  .stat-grid{grid-template-columns:1fr;}
  .payslip-grid{grid-template-columns:1fr;}
}
</style>

